{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Компилировать манифест (windres)",
      "type": "shell",
      "command": "windres",
      "args": [
        "src/resource.rc",
        "-O", "coff",
        "-o", "src/resource_res.o"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "2. Собрать CurrencyConverter.exe",
      "type": "shell",
      "command": "g++",
      "args": [
        "-O2",
        "-mwindows",
        "-static",
        "-std=c++17",
        "-municode",
        "src/main.cpp",
        "src/View.cpp",
        "src/Controller.cpp",
        "src/resource_res.o",
        "-o",
        "CurrencyConverter.exe"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["1. Компилировать манифест (windres)"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
